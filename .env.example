# DREAM WORLD: 3D Open-World Adventure
# Environment Configuration Example

# Port the server listens on (defaults to 3000 in AI Studio / container)
PORT=3000

# Node environment ('development' | 'production')
NODE_ENV=development

# Optional custom backend URL (if frontend is hosted on separate domain like GitHub Pages)
VITE_BACKEND_URL=

# Base path override for Vite (defaults to '/' in dev/preview, '/dream-world-open/' in GitHub Actions)
VITE_BASE_PATH=/
